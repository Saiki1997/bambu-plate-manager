{
  "name": "bambu-plate-manager",
  "version": "0.6.0",
  "description": "BambuPlate OCR & Filament Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.bambu.platemanager",
    "productName": "BambuPlate Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "python/src",
        "filter": ["**/*"]
      },
      {
        "from": "../main.py",
        "to": "python/main.py"
      },
      {
        "from": "../requirements.txt",
        "to": "python/requirements.txt"
      }
    ]
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
